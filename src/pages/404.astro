---

import Baselayouts from "../layouts/Baselayouts.astro";

---

<Baselayouts title="页面不存在">
    <section class="not-found">
        <h1>404</h1>
        <p>这个页面不存在，或者已经被移走了。</p>
        <a href={`${import.meta.env.BASE_URL}`}>回到首页</a>
    </section>

</Baselayouts>

<style>
    .not-found {
        margin: 3rem;
        padding: 1rem;
    }

    .not-found h1 {
        max-width: 36rem;
        margin: 1rem auto;
        font-size: 5rem;
        text-align: center;
    }

    .not-found p {
        font-size: 3rem;
        text-align: center;
    }

    .not-found a {
        font-size: 2rem;
        margin-top: 1.5rem;
    }
</style>