---

import Baselayouts from "../../layouts/Baselayouts.astro";
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const base = import.meta.env.BASE_URL;

---

<Baselayouts title="文章列表">

    <h1>文章</h1>

    <div id="tag-filter" class="tag-filter">
        <button type="button" data-tag="all">全部</button>
    </div>
    <div id="tag-filter" class="tag-filter">
        <button type="button" data-tag="test">测试</button>
    </div>
    
    <ul class="post-list" id="post-list">
        {posts.map(post => (
            <li class="post-item" data-tags={post.data.tags.join(',')}>
                <article>
                    <h2>
                        <a href={`${base}/blog/${post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a>
                    </h2>
                    <time datetime={post.data.date.toISOString().slice(0, 10)}>{post.data.date.toISOString().slice(0, 10)}</time>
                    <p>{post.data.excerpt}</p>
                    <ul class="post-tags">
                        {post.data.tags.map(tag => (<li>{tag}</li>))}
                    </ul>
                </article>
            </li>
        ))}
    </ul>

    <script>
        const buttons = document.querySelectorAll<HTMLBaseElement>('#tag-filter button');
        const items = document.querySelectorAll<HTMLLIElement>('#post-list .post-item')
        
        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                const tag = btn.dataset.tag
                if(!tag) return;

                items.forEach(item => {
                    const tags = item.dataset.tags?.split(',') ?? [];
                    item.hidden = tag != 'all' && !tags.includes(tag);
                });
            });
        });
    </script>

</Baselayouts>
<style>
    .post-list {
    list-style: none;
    gap: 1rem;
    margin-top: 1rem;
    }

    .post-item article{
        border: 1px;
        border-radius: 8px;
        padding: 1rem;
    }

    .post-item h2 {
        margin-bottom: 0.25rem;
    }

    .post-item time {
        font-size: 0.875rem;
        color: var(--color-muted);
    }

    .post-tags {
        list-style: none;
        display: flex;
        gap: 0.5rem;
        margin-top: 0.75rem;
        padding: 0;
        flex-wrap: wrap;
    }

    .post-tags li {
        font-size: 0.75rem;
        background: var(--color-bg);
        padding: 0.125rem;
        border-radius: 999px;
    }

    .tag-filter {
        display: flex;
        flex-wrap: nowrap;
        margin-top: 0.5rem;
        gap: 0.75rem;
    }

    .tag-filter button {
        cursor: pointer;
        padding: 0.25rem; 
        border: 1px solid var(--color-border);
        background: var(--color-bg);
        border-radius: 999px;
        font: inherit;
    }

    @media (min-width: 640px) {
        .post-list {
            gap: 1.5rem;
            margin-top: 1.5rem;
        }

        .post-item article{
            padding: 1.25rem;
        }
    }
</style>