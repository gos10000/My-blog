---

import Baselayouts from "../../layouts/Baselayouts.astro";
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const base = import.meta.env.BASE_URL;

---

<Baselayouts title="文章列表">

    <h1>文章</h1>

    <div id="tag-filter" class="tag-filter">
        <button type="button" data-tag="all">全部</button>
    </div>
    <div id="tag-filter" class="tag-filter">
        <button type="button" data-tag="test">测试</button>
    </div>
    
    <ul class="post-list" id="post-list">
        {posts.map(post => (
            <li class="post-item" data-tags={post.data.tags.join(',')}>
                <article>
                    <h2>
                        <a href={`${base}/blog/${post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a>
                    </h2>
                    <time datetime={post.data.date.toISOString().slice(0, 10)}>{post.data.date.toISOString().slice(0, 10)}</time>
                    <p>{post.data.excerpt}</p>
                    <ul class="post-tags">
                        {post.data.tags.map(tag => (<li>{tag}</li>))}
                    </ul>
                </article>
            </li>
        ))}
    </ul>

    <script>
        const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-filter button');
        const items = document.querySelectorAll<HTMLLIElement>('#post-list .post-item')
        
        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                const tag = btn.dataset.tag
                if(!tag) return;

                items.forEach(item => {
                    const tags = item.dataset.tags?.split(',') ?? [];
                    item.hidden = tag != 'all' && !tags.includes(tag);
                });
            });
        });
    </script>

</Baselayouts>
<style>
    .post-list {
        display: grid;
        gap: var(--space-4);
        list-style: none;
        margin-top: var(--space-4);
    }

    .post-item > article {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        padding: var(--space-5);
    }

    .post-item > article:hover {
        border-color: var(--color-border-strong);
        box-shadow: var(--color-shadow-hover);
        transform: translateY(-2px);
    }

    .post-item h2 {
        font-size: 1.25rem;
        margin-bottom: 0;
    }

    .post-item h2 a {
        color: var(--color-text);
    }

    .post-item h2 a:hover {
        color: var(--color-accent);
    }

    .post-item time {
        font-size: 0.8125rem;
        color: var(--color-muted);
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.02em;
    }

    .post-item p {
        color: var(--color-text-soft);
    }

    .post-item .post-tags {
        margin-top: var(--space-1);
    }

    .tag-filter {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
        margin-top: var(--space-4);
    }

    .tag-filter + .tag-filter {
        margin-top: var(--space-2);
    }

    .tag-filter button {
        padding: 0.3rem 0.9rem;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-pill);
        background: var(--color-card-bg);
        font-size: 0.875rem;
        color: var(--color-text-soft);
        transition: border-color var(--transition), background-color var(--transition),
            color var(--transition);
    }

    .tag-filter button:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
        background: var(--color-accent-soft);
    }

    @media (min-width: 640px) {
        .post-list {
            gap: var(--space-5);
            margin-top: var(--space-5);
        }

        .post-item > article {
            padding: var(--space-5) var(--space-6);
        }
    }
</style>