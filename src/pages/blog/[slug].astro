---
import type { GetStaticPaths } from "astro";

import Baselayouts from "../../layouts/Baselayouts.astro"
import { posts } from "../../data/posts"
import type { Post } from "../../data/posts"

export function getStaticPaths() {
    return posts.map( post => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

interface Props {
    post: Post
}

const { post } = Astro.props
const base = import.meta.env.BASE_URL

---

<Baselayouts title={post.title} discription={post.excerpt}>
    <article class="post">
        <header>
            <h1>{ post.title }</h1>
            <time datetime={post.date}>{post.date}</time>
            <ul class="post-tags">
                {post.tags.map( tag => <li>{tag}</li>)}
            </ul>
        </header>

        <div class="post-body" set:html={post.body} />

        <footer>
            <a href={`${base}/blog`}>返回文章列表</a>
        </footer>
    </article>

</Baselayouts>
<style>
    .post {
        max-width: 42rem;
        margin: 0 auto;
    }
    .post header {
        margin: 2rem;
    }
    .post header h1 {
        margin: 0.5rem;
    }
    .post header time {
        font-size: 0.875rem;
        color: #666;
    }
    
    .post-tags {
        list-style: none;
        display: flex;
        gap: 0.5rem;
        margin-top: 0.75rem;
        padding: 0;
    }
    .post-body {
        line-height: 1.8rem;
    }
    .post footer {
        margin-top: 3rem;
        padding-top: 1rem;
        border-top: 1px solid #e5e5e5;
    }
</style>