---

import Baselayouts from "../../layouts/Baselayouts.astro";
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;

---

<Baselayouts title={post.data.title} discription={post.data.excerpt}>
  <article class="post">
    <header>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.date.toISOString().slice(0, 10)}>
        {post.data.date.toISOString().slice(0, 10)}
      </time>
      <ul class="post-tags">
        {post.data.tags.map(tag => <li>{tag}</li>)}
      </ul>
    </header>

    <div class="post-body">
      <Content />
    </div>

    <footer>
      <a href={`${base}/blog/`}>← 返回文章列表</a>
    </footer>
  </article>
</Baselayouts>

<style>
    .post {
        max-width: var(--content-width);
        margin-inline: auto;
    }

    .post-header,
    .post > header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-3);
        margin-bottom: var(--space-6);
        padding-bottom: var(--space-5);
        border-bottom: 1px solid var(--color-border);
    }

    .post > header h1 {
        flex-basis: 100%;
        margin: 0;
    }

    .post > header time {
        font-size: 0.875rem;
        color: var(--color-muted);
        font-variant-numeric: tabular-nums;
    }

    .post > header .post-tags {
        margin: 0;
    }

    .post-body {
        line-height: 1.85;
    }

    .post > footer {
        margin-top: var(--space-7);
        padding-top: var(--space-4);
        border-top: 1px solid var(--color-border);
        font-size: 0.9375rem;
        text-align: left;
        color: var(--color-muted);
    }

    .post > footer a {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.8rem;
        margin-left: -0.8rem;
        border-radius: var(--radius-pill);
        font-weight: 500;
        transition: background-color var(--transition), color var(--transition);
    }

    .post > footer a:hover {
        background: var(--color-accent-soft);
    }
</style>