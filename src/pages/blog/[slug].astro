---

import Baselayouts from "../../layouts/Baselayouts.astro";
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;

---

<Baselayouts title={post.data.title} discription={post.data.excerpt}>
  <article class="post">
    <header>
      <h1>{post.data.title}</h1>
      <time datetime={post.data.date.toISOString().slice(0, 10)}>
        {post.data.date.toISOString().slice(0, 10)}
      </time>
      <ul class="post-tags">
        {post.data.tags.map(tag => <li>{tag}</li>)}
      </ul>
    </header>

    <div class="post-body">
      <Content />
    </div>

    <footer>
      <a href={`${base}/blog/`}>← 返回文章列表</a>
    </footer>
  </article>
</Baselayouts>

<style>
    .post {
        max-width: 42rem;
        margin: 0 auto;
    }
    .post header {
        margin: 2rem;
    }
    .post header h1 {
        margin: 0.5rem;
    }
    .post header time {
        font-size: 0.875rem;
        color: var(--color-muted);
    }
    
    .post-tags {
        list-style: none;
        display: flex;
        gap: 0.5rem;
        margin-top: 0.75rem;
        padding: 0;
    }
    .post-body {
        line-height: 1.8rem;
    }
    .post footer {
        margin-top: 3rem;
        padding-top: 1rem;
        border-top: 1px solid var(--color-border);
    }
</style>