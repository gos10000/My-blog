---

interface Props {
    title: string;
    discription?: string;     
}

const {title, discription = "无尾熊的博客"} = Astro.props

---

<html lang="zh-CH">
    <header>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="discription" content={discription}>
        <title>{title}</title>
    </header>
    <body>
        <header>
            <nav>
                <a href="/">首页</a>
                <a href="/blog">文章</a>
                <a href="/about">关于</a>
            </nav>
        </header>
        <main>
            <slot />
        </main>
        <footer>
            <p>&copy; 2026 无尾熊的博客</p>
        </footer>
    </body>
</html>
